# Copy this file to .env and fill in your own values.
# Nothing in Phase 1 needs an LLM API key of any kind.

# --- eBay Developer Program (developer.ebay.com) ---
# Free to sign up. Browse API only needs an "Application access token"
# (client-credentials grant) - no user login flow required for search.
EBAY_CLIENT_ID=
EBAY_CLIENT_SECRET=
# "PRODUCTION" once your app is approved for production; "SANDBOX" for testing.
EBAY_ENV=SANDBOX

# --- Telegram bot (talk to @BotFather on Telegram, /newbot) ---
TELEGRAM_BOT_TOKEN=
# Your own numeric Telegram user id (message @userinfobot to get it).
# Restricts the bot to only respond to you.
TELEGRAM_OWNER_ID=

# --- Web app auth (webapp.py) ---
# Leave both blank for local use - no password prompt. Set both before
# exposing this on the VM, or anyone with the link can see and control it.
WEBAPP_USERNAME=
WEBAPP_PASSWORD=

# --- Search behaviour ---
# Comma-separated eBay search queries to poll.
SEARCH_QUERIES=sony cybershot untested,sony dsc untested,sony cybershot no battery
# How often to poll, in minutes.
POLL_INTERVAL_MINUTES=15
